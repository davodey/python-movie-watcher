{
  "tmdb_api_key": "YOUR_TMDB_API_KEY",
  "n8n_webhook_url": "http://localhost:5678/webhook/enrich-metadata",

  "watch_directories": [
    {
      "source": "/mnt/media/torrents/complete/movies",
      "destination": "/mnt/media/sanatize/movies",
      "media_type": "movie"
    },
    {
      "source": "/mnt/media/torrents/complete/radarr",
      "destination": "/mnt/media/sanatize/movies",
      "media_type": "movie"
    },
    {
      "source": "/mnt/media/torrents/complete/tv",
      "destination": "/mnt/media/sanatize/tv",
      "media_type": "tv"
    },
    {
      "source": "/mnt/media/torrents/complete/sonarr",
      "destination": "/mnt/media/sanatize/tv",
      "media_type": "tv"
    }
  ],

  "watch_interval": 60,
  "database_path": "./sanitizer.db",
  "log_file": "./sanitizer.log",

  "tmdb_options": {
    "include_adult": false,
    "language": "en-US",
    "image_base_url": "https://image.tmdb.org/t/p/original"
  },

  "n8n_options": {
    "timeout": 30,
    "retry_count": 3
  },

  "file_extensions": [".mkv", ".mp4", ".avi", ".m4v", ".wmv", ".mov"],
  "subtitle_extensions": [".srt", ".sub", ".ass", ".ssa", ".vtt", ".idx"],
  "min_file_size_mb": 100,
  "settle_time": 30
}
